  "data": {
    "$description": "Categorical / row-tone hues at the brand-bright (.400) step so decorative icons and chart series read on dark surfaces. `categorical.N`/`status.*` below are the fill/fill-strong/fill-soft triad (see light.tokens.json's `data` group description for the full a11y contract - fills/strokes on non-text surfaces ONLY). Dark steps deliberately DIFFER from light's naive +0 mapping: fill=.400 (not .500 - matches data-bright's own rationale that .500 falls below AA for graphics on dark) and fill-strong=.300 (matches data-tone.*'s own dark `solid` rung) - both mirror the step-down this brand already applies to vivid colour on dark. fill-soft=.800 sinks the area/track fill down near the dark surface, the mirror of light's .200.",
    "series-1": {
      "$value": "{brand.data-bright.1}"
    },
    "series-2": {
      "$value": "{brand.data-bright.2}"
    },
    "series-3": {
      "$value": "{brand.data-bright.3}"
    },
    "series-4": {
      "$value": "{brand.data-bright.4}"
    },
    "series-5": {
      "$value": "{brand.data-bright.5}"
    },
    "series-6": {
      "$value": "{brand.data-bright.6}"
    },
    "categorical": {
      "1": {
        "fill": { "$value": "{brand.data-tone.1.400}" },
        "fill-strong": { "$value": "{brand.data-tone.1.300}" },
        "fill-soft": { "$value": "{brand.data-tone.1.800}" }
      },
      "2": {
        "fill": { "$value": "{brand.data-tone.2.400}" },
        "fill-strong": { "$value": "{brand.data-tone.2.300}" },
        "fill-soft": { "$value": "{brand.data-tone.2.800}" }
      },
