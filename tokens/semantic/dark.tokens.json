{
  "$type": "color",
  "$description": "Dark theme. Additive over light: the resolver loads light first, then these overrides. Only the tokens that must change in the dark are present. Like light, references ONLY the brand tier for hue-bearing colour (hueless overlays/scrim/shadows stay in primitives). Neutrals stay in the brand fill hue family. Note `inverted` flips to a LIGHT block here, the opposite of this theme's base.",
  "action": {
    "accent": {
      "$value": "{brand.primary-bright}",
      "$description": "Emphasis/icon/accent-text colour. Brand-bright step so accents and icons meet AA on dark surfaces."
    },
    "quiet": {
      "$value": "{brand.fill.50}",
      "$description": "Outline/tertiary button text must be light on dark surfaces."
    }
  },
  "focus": {
    "ring": {
      "$value": "{brand.fill.50}",
      "$description": "Focus ring must be visible on dark surfaces."
    }
  },
  "status": {
    "$description": "Dark-mode status. The light theme's tints render as glaring light chips on dark, and its solids are illegible as foreground on dark. Flipped (mirrors property dark): tint = dark tint (.900), tint-strong = .700 (icon-tile backing on dark), border = .500 (soft hairline — sits between the .400 vivid accent and the .700 backing, so a toned box's stroke reads gently against a dark body), accent = .400 (vivid decorative, reads on dark), solid = light solid (.300); on = dark ink for a light solid fill.",
    "info": {
      "tint": {
        "$value": "{brand.status.info.900}"
      },
      "tint-strong": {
        "$value": "{brand.status.info.700}"
      },
      "border": {
        "$value": "{brand.status.info.500}"
      },
      "accent": {
        "$value": "{brand.status.info.400}"
      },
      "solid": {
        "$value": "{brand.status.info.300}"
      },
      "on": {
        "$value": "{brand.ink.950}"
      }
    },
    "success": {
      "tint": {
        "$value": "{brand.status.success.900}"
      },
      "tint-strong": {
        "$value": "{brand.status.success.700}"
      },
      "border": {
        "$value": "{brand.status.success.500}"
      },
      "accent": {
        "$value": "{brand.status.success.400}"
      },
      "solid": {
        "$value": "{brand.status.success.300}"
      },
      "on": {
        "$value": "{brand.ink.950}"
      }
    },
    "warning": {
      "tint": {
        "$value": "{brand.status.warning.900}"
      },
      "tint-strong": {
        "$value": "{brand.status.warning.700}"
      },
      "border": {
        "$value": "{brand.status.warning.500}"
      },
      "accent": {
        "$value": "{brand.status.warning.400}"
      },
      "solid": {
        "$value": "{brand.status.warning.300}"
      },
      "on": {
        "$value": "{brand.ink.950}"
      }
    },
    "error": {
      "tint": {
        "$value": "{brand.status.error.900}"
      },
      "tint-strong": {
        "$value": "{brand.status.error.700}"
      },
      "border": {
        "$value": "{brand.status.error.500}"
      },
      "accent": {
        "$value": "{brand.status.error.400}"
      },
      "solid": {
        "$value": "{brand.status.error.300}"
      },
      "on": {
        "$value": "{brand.ink.950}"
      }
    }
  },
  "data-tone": {
    "$description": "Dark-mode data-tone (see semantic/light.tokens.json data-tone). Flipped like status: tint = .900, tint-strong = .700, accent = .400, solid = .300; on = dark ink for the light solid.",
